# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...          # server-only, never expose to the client

# FastAPI ML service
NEXT_PUBLIC_ML_SERVICE_URL=https://aisalesforesight-ml.onrender.com
NEXT_PUBLIC_APP_URL=https://aisalesforesight.com
# Note: INTERNAL_JOBS_SECRET lives on the FastAPI service itself (not here) —
# see fastapi-service/.env.example and .github/workflows/scheduled-jobs.yml

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe — international customers (USD / AED / SAR), one Price ID per currency per plan
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC_USD=price_...
STRIPE_PRICE_BASIC_AED=price_...
STRIPE_PRICE_BASIC_SAR=price_...
STRIPE_PRICE_PRO_USD=price_...
STRIPE_PRICE_PRO_AED=price_...
STRIPE_PRICE_PRO_SAR=price_...

# Razorpay — Indian customers (INR, UPI/cards/netbanking)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_BASIC=plan_...
RAZORPAY_PLAN_PRO=plan_...
